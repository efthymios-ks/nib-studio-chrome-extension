{
  "name": "nib-studio",
  "version": "0.0.3",
  "private": true,
  "description": "Open a folder on your computer to edit, compare, search and preview its files in a browser tab. Works offline; nothing is uploaded.",
  "author": "Efthymios Koktsidis <efthymios.ks@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
